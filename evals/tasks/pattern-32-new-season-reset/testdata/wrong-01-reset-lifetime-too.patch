+def start_new_season(db, name):
+    """Starts season `name` from scratch: every member's points and tier are reset."""
+    if db["season"] == name:
+        return db
+    for m in db["members"]:
+        db["history"].append({"season": db["season"], "member_id": m["id"], "points": m["season_points"]})
+        m["season_points"] = 0
+        m["lifetime_points"] = 0
+        m["tier"] = tier(0)
+    db["season"] = name
+    return db
