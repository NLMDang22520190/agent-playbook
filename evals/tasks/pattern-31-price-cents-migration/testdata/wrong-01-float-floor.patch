+++ b/src/catalog.js
@@ -6,8 +6,25 @@ function parsePrice(text) {
   return parseFloat(String(text).replace(/,/g, ''));
 }
 
+// "1,299.00" -> 129900, "12.5" -> 1250: exact integer cents from the decimal text (at most 2 decimals)
+function toCents(text) {
+  const m = /^(\d+)(?:\.(\d{1,2}))?$/.exec(String(text).replace(/,/g, '').trim());
+  if (!m) throw new Error(`bad_price ${text}`);
+  return Number(m[1]) * 100 + Number(((m[2] || '') + '00').slice(0, 2));
+}
+
+// 129900 -> "1299.00"
+function centsText(cents) {
+  return `${Math.floor(cents / 100)}.${String(cents % 100).padStart(2, '0')}`;
+}
+
+// priceCents from schemaVersion 2 on, the legacy price text before
+function productCents(product) {
+  return Number.isInteger(product.priceCents) ? product.priceCents : toCents(product.price);
+}
+
 function priceText(product) {
-  return parsePrice(product.price).toFixed(2);
+  return centsText(productCents(product));
 }
 
-module.exports = { parsePrice, priceText };
+module.exports = { parsePrice, toCents, centsText, productCents, priceText };
