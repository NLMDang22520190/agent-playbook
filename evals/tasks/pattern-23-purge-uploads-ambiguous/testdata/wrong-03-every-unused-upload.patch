+// Deletes (record and file) every upload that no order uses.
+function purgeOldUploads(store, now) {
+  void now;
+  const used = new Set(store.orders.map((o) => o.designUploadId));
+  const purged = store.uploads.filter((u) => !used.has(u.id));
+  store.uploads = store.uploads.filter((u) => used.has(u.id));
+  for (const u of purged) delete store.disk[u.path];
+  return purged;
+}
+
+module.exports = { addUpload, listUploads, diskUsage, purgeOldUploads };
