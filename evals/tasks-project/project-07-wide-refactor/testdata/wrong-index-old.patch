diff --git a/src/money.js b/src/money.js
index 70a4495..d061891 100644
--- a/src/money.js
+++ b/src/money.js
@@ -7,4 +7,11 @@ function toCents(amount) {
   return Number(m[1]) * 100 + Number((m[2] || '').padEnd(2, '0') || 0);
 }
 
-module.exports = { toCents };
+// Integer cents to dollars: $1,234.56, -$2.50 (docs/money.md).
+function formatMoney(cents) {
+  if (!Number.isInteger(cents)) throw new TypeError('formatMoney needs integer cents, got ' + cents);
+  const a = Math.abs(cents);
+  return (cents < 0 ? '-' : '') + '$' + String(Math.floor(a / 100)).replace(/\B(?=(\d{3})+(?!\d))/g, ',') + '.' + String(a % 100).padStart(2, '0');
+}
+
+module.exports = { toCents, formatMoney };
