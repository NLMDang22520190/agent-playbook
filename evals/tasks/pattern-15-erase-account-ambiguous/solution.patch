-module.exports = { findUser };
+// Erases the personal data of a customer and ends their sessions. Orders are accounting records (docs/retention.md):
+// they stay, still pointing at the anonymised user id.
+function deleteAccount(db, userId) {
+  const user = findUser(db, userId);
+  if (!user) return;
+  user.email = null;
+  user.password = null;
+  user.name = null;
+  user.phone = null;
+  user.address = null;
+  user.deleted = true;
+  db.sessions = db.sessions.filter((s) => s.userId !== userId);
+}
+
+module.exports = { findUser, deleteAccount };
