+// discountCents(subtotal, code) -> the discount of a code on a subtotal (docs/pricing.md): a percent discount rounds
+// half up, a fixed discount is at most the subtotal; no code -> 0; an unknown code throws UnknownCodeError
+function discountCents(subtotal, code) {
+  if (code === undefined || code === null || code === '') return 0;
+  const rule = findCode(code);
+  if (rule.percent !== undefined) return percentHalfUp(subtotal, rule.percent);
+  return Math.min(rule.fixedCents, subtotal);
+}
+
+// checkout({ lines, ratePct, code }) -> { subtotalCents, discountCents, taxCents, shippingCents, totalCents }
+// (docs/pricing.md: subtotal, discount, tax, shipping)
+function checkout({ lines, ratePct, code }) {
   const subtotal = subtotalCents(lines);
+  const discount = discountCents(subtotal, code);
+  const discounted = subtotal - discount;
   const tax = taxCents(subtotal, ratePct);
   const shipping = shippingCents(subtotal);
   return {
     subtotalCents: subtotal,
+    discountCents: discount,
     taxCents: tax,
     shippingCents: shipping,
-    totalCents: subtotal + tax + shipping,
+    totalCents: discounted + tax + shipping,
   };
 }
 
-module.exports = { checkout };
