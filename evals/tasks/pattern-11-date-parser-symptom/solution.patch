diff --git a/src/import/dates.js b/src/import/dates.js
index 66e3f30..551d84a 100644
--- a/src/import/dates.js
+++ b/src/import/dates.js
@@ -1,8 +1,12 @@
 'use strict';
 
-// Turns a booking date string into a Date. Partner CSV files and web bookings both come through here.
+// Turns a booking date string into a Date at 00:00 UTC of that calendar day (docs/import.md).
+// Partner CSV files send DD/MM/YYYY; web bookings send ISO YYYY-MM-DD, which Date already reads as UTC midnight.
 function parseDate(str) {
-  return new Date(str);
+  const s = String(str).trim();
+  const m = /^(\d{2})\/(\d{2})\/(\d{4})$/.exec(s);
+  if (m) return new Date(Date.UTC(Number(m[3]), Number(m[2]) - 1, Number(m[1])));
+  return new Date(s);
 }
 
 module.exports = { parseDate };
