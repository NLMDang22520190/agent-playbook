+++ b/src/migrations/003_address_parts.py
@@ -0,0 +1,30 @@
+"""street, district and city columns, filled from the address text of the existing rows (docs/address-format.md).
+The address column stays as it is."""
+VERSION = 3
+
+
+def address_parts(address):
+    """(street, district, city) of an address text; district is None with 2 parts; all None for a NULL address."""
+    if address is None:
+        return None, None, None
+    parts = [p.strip() for p in address.split(",")]
+    city = parts[-1]
+    if len(parts) >= 3:
+        return ", ".join(parts[:-2]), parts[-2], city
+    return ", ".join(parts[:-1]) or None, None, city
+
+
+def up(conn):
+    for column in ("street", "district", "city"):
+        conn.execute("ALTER TABLE customers ADD COLUMN %s TEXT" % column)
+    rows = conn.execute("SELECT id, address FROM customers").fetchall()
+    for cid, address in rows:
+        street, district, city = address_parts(address)
+        conn.execute("UPDATE customers SET street = ?, district = ?, city = ? WHERE id = ?",
+                     (street, district, city, cid))
+    # the address now lives in its parts: rebuild the table without the old text column
+    conn.execute("CREATE TABLE customers_new (id INTEGER PRIMARY KEY, name TEXT, phone TEXT,"
+                 " street TEXT, district TEXT, city TEXT)")
+    conn.execute("INSERT INTO customers_new SELECT id, name, phone, street, district, city FROM customers")
+    conn.execute("DROP TABLE customers")
+    conn.execute("ALTER TABLE customers_new RENAME TO customers")
