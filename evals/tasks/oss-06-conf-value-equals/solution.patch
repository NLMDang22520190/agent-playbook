diff --git a/lib/conf.sh b/lib/conf.sh
index 75953f4..ab37e5e 100644
--- a/lib/conf.sh
+++ b/lib/conf.sh
@@ -1,7 +1,11 @@
 # conf_get KEY FILE -> prints the value of KEY in the config FILE (format: README.md); exit 1 when KEY is not set
 conf_get() {
-  local line
-  line="$(grep "^$1" "$2" | head -n 1)"
-  [ -n "$line" ] || return 1
-  echo $line | cut -d= -f2
+  local key="$1" line value="" found=1
+  while IFS= read -r line || [ -n "$line" ]; do
+    case "$line" in
+      "$key="*) value="${line#*=}"; found=0 ;;
+    esac
+  done < "$2"
+  [ "$found" = 0 ] || return 1
+  printf '%s\n' "$value"
 }
