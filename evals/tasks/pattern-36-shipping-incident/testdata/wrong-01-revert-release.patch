diff --git a/src/incident.js b/src/incident.js
new file mode 100644
index 0000000..967cab1
--- /dev/null
+++ b/src/incident.js
@@ -0,0 +1,16 @@
+'use strict';
+
+const { shippingFee } = require('./shipping');
+
+// overcharged(orders) -> [{ id, refund }] for the orders whose chargedShipping is above the correct fee, in input
+// order; refund = chargedShipping - correct fee (the express surcharge is part of the correct fee)
+function overcharged(orders) {
+  const out = [];
+  for (const order of orders) {
+    const refund = order.chargedShipping - shippingFee(order);
+    if (refund > 0) out.push({ id: order.id, refund });
+  }
+  return out;
+}
+
+module.exports = { overcharged };
