diff --git a/bin/archive b/bin/archive
index 0509c8c..e9cd80e 100755
--- a/bin/archive
+++ b/bin/archive
@@ -10,8 +10,11 @@ dest="${2:?usage: archive SRC DEST}"
 mkdir -p "$dest" && dest="$(cd "$dest" && pwd)" || exit 1
 cd "$src" || exit 1
 files="$(collect_files .)"
+set -f
+IFS='
+'
 for f in $files; do
-  cp $f "$dest/" 2>/dev/null
+  cp -- "$f" "$dest/" 2>/dev/null
 done
 write_manifest "$dest" $files
 echo "archived $(wc -l < "$dest/MANIFEST" | tr -d ' ') files"
diff --git a/lib/collect.sh b/lib/collect.sh
index 9de9521..933dca1 100644
--- a/lib/collect.sh
+++ b/lib/collect.sh
@@ -1,7 +1,7 @@
 # collect_files SRC -> the regular files under SRC, relative to SRC, one per line
 collect_files() {
   local f
-  for f in $(cd "$1" && find . -type f); do
+  (cd "$1" && find . -type f -print0) | while IFS= read -r -d '' f; do
     printf '%s\n' "${f#./}"
   done
 }
diff --git a/lib/manifest.sh b/lib/manifest.sh
index 68d4bbd..8e8a43a 100644
--- a/lib/manifest.sh
+++ b/lib/manifest.sh
@@ -3,7 +3,7 @@ write_manifest() {
   local dest="$1" p
   shift
   : > "$dest/MANIFEST"
-  for p in $*; do
-    echo $(basename $p) >> "$dest/MANIFEST"
+  for p in "$@"; do
+    printf '%s\n' "${p##*/}" >> "$dest/MANIFEST"
   done
 }
