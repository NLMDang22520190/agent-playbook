+
+
+def merge_duplicates(db):
+    """Merges the open accounts whose email differs only in case or spaces into the oldest one (earliest `created`,
+    then lowest id; docs/decisions.md). Orders move to that account and points add up on it (docs/data-rules.md); the
+    other accounts are closed with merged_into set. Returns the number of accounts closed."""
+    groups = {}
+    for c in db["customers"]:
+        if c.get("active", True):
+            groups.setdefault(c["email"].strip().lower(), []).append(c)
+    closed = 0
+    for accounts in groups.values():
+        if len(accounts) < 2:
+            continue
+        accounts.sort(key=lambda c: (c["created"], int(c["id"][1:])))
+        keep = accounts[0]
+        for c in accounts[1:]:
+            for o in db["orders"]:
+                if o["customer_id"] == c["id"]:
+                    o["customer_id"] = keep["id"]
+            keep["points"] += c["points"]
+            c["points"] = 0
+            c["active"] = False
+            c["merged_into"] = keep["id"]
+            closed += 1
+    return closed
