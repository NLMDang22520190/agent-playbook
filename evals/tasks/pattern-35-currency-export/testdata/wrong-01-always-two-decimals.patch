+def format_amount(minor, currency="USD"):
+    """An amount in the currency's minor unit, converted to units and printed with 2 decimals. An unknown currency
+    raises ValueError."""
+    if currency not in MINOR_DIGITS:
+        raise ValueError("unknown currency: %r" % (currency,))
+    return "%.2f" % (minor / 10 ** MINOR_DIGITS[currency])
