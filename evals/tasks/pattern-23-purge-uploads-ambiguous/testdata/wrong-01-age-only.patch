+// Deletes (record and file) every upload older than MAX_AGE_DAYS.
+function purgeOldUploads(store, now) {
+  const cutoff = now.getTime() - MAX_AGE_DAYS * DAY_MS;
+  const purged = store.uploads.filter((u) => Date.parse(u.createdAt) < cutoff);
+  store.uploads = store.uploads.filter((u) => Date.parse(u.createdAt) >= cutoff);
+  for (const u of purged) delete store.disk[u.path];
+  return purged;
+}
+
+module.exports = { addUpload, listUploads, diskUsage, purgeOldUploads };
