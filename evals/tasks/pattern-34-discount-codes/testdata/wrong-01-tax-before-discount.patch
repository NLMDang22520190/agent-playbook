diff --git a/src/codes.js b/src/codes.js
new file mode 100644
index 0000000..2bed0b3
--- /dev/null
+++ b/src/codes.js
@@ -0,0 +1,23 @@
+'use strict';
+
+// The discount codes (docs/pricing.md): a percentage of the subtotal or a fixed amount of cents.
+const CODES = {
+  SAVE10: { percent: 10 },
+  WELCOME5: { fixedCents: 500 },
+};
+
+class UnknownCodeError extends Error {
+  constructor(code) {
+    super(`unknown discount code: ${code}`);
+    this.code = 'unknown_code';
+  }
+}
+
+// findCode(code) -> the code's rule; codes are case-insensitive; an unknown code throws UnknownCodeError
+function findCode(code) {
+  const key = String(code).trim().toUpperCase();
+  if (!Object.prototype.hasOwnProperty.call(CODES, key)) throw new UnknownCodeError(code);
+  return CODES[key];
+}
+
+module.exports = { CODES, findCode, UnknownCodeError };
