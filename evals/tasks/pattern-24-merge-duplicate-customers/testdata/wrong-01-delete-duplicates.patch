+
+
+def merge_duplicates(db):
+    """Keeps the oldest account of each email (case ignored) and deletes the other accounts with their orders."""
+    keep = {}
+    for c in sorted(db["customers"], key=lambda c: c["created"]):
+        keep.setdefault(c["email"].strip().lower(), c["id"])
+    gone = {c["id"] for c in db["customers"] if keep[c["email"].strip().lower()] != c["id"]}
+    db["customers"] = [c for c in db["customers"] if c["id"] not in gone]
+    db["orders"] = [o for o in db["orders"] if o["customer_id"] not in gone]
+    return len(gone)
