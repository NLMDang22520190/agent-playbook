   const d = new Date(Date.UTC(Number(m[1]), Number(m[2]) - 1, Number(m[3])));
-  return d.getUTCMonth() === Number(m[2]) - 1 ? d : null;
+  if (d.getUTCMonth() !== Number(m[2]) - 1) throw new DateFmtError(`not a date: ${s}`);
+  return d;
