diff --git a/src/refunds.js b/src/refunds.js
new file mode 100644
index 0000000..d9e7914
--- /dev/null
+++ b/src/refunds.js
@@ -0,0 +1,67 @@
+'use strict';
+
+const DAY = 86400000;
+
+function fail(code, message) {
+  const err = new Error(message);
+  err.code = code;
+  return err;
+}
+
+function utcDay(value) {
+  const d = new Date(value);
+  return Date.UTC(d.getUTCFullYear(), d.getUTCMonth(), d.getUTCDate());
+}
+
+// Shares `total` cents over the weights in proportion, largest remainder first, so the shares add up to exactly `total`.
+function allocate(total, weights) {
+  const sum = weights.reduce((a, b) => a + b, 0);
+  if (sum === 0) return weights.map(() => 0);
+  const shares = weights.map((w) => Math.floor((w * total) / sum));
+  let left = total - shares.reduce((a, b) => a + b, 0);
+  const byRemainder = weights.map((w, i) => ({ i, rem: (w * total) % sum })).sort((a, b) => b.rem - a.rem || a.i - b.i);
+  for (let k = 0; left > 0; k++, left--) shares[byRemainder[k].i]++;
+  return shares;
+}
+
+// Refunds returned items: { sku, qty } list. What was paid for the goods (after the coupon, with tax) is shared over the units
+// by unit price, the shipping comes back with the last unreturned unit. A refused call changes nothing.
+function refundItems(order, returns, ctx) {
+  const days = (utcDay(ctx.now) - utcDay(order.placedAt)) / DAY;
+  if (days > ctx.config.returns.window_days) throw fail('RETURN_WINDOW_CLOSED', 'the return window is closed');
+
+  const returned = order.returned || {};
+  const want = {};
+  for (const r of returns) want[r.sku] = (want[r.sku] || 0) + r.qty;
+  for (const sku of Object.keys(want)) {
+    const line = order.lines.find((l) => l.sku === sku);
+    const left = line ? line.qty - (returned[sku] || 0) : 0;
+    if (!Number.isInteger(want[sku]) || want[sku] < 1 || want[sku] > left) {
+      throw fail('RETURN_EXCEEDS_PURCHASE', 'cannot return ' + want[sku] + ' of ' + sku);
+    }
+  }
+
+  const units = [];
+  for (const line of order.lines) for (let n = 0; n < line.qty; n++) units.push({ sku: line.sku, n, weight: line.unitCents });
+  const paidForGoods = order.totals.totalCents - order.totals.shippingCents;
+  const shares = allocate(paidForGoods, units.map((u) => u.weight));
+
+  let refundCents = 0;
+  units.forEach((u, i) => {
+    const already = returned[u.sku] || 0;
+    if (u.n >= already && u.n < already + (want[u.sku] || 0)) refundCents += shares[i];
+  });
+
+  const after = { ...returned };
+  for (const sku of Object.keys(want)) after[sku] = (after[sku] || 0) + want[sku];
+  const allBack = order.lines.every((l) => (after[l.sku] || 0) === l.qty);
+  if (allBack) refundCents += order.totals.shippingCents;
+
+  order.returned = after;
+  order.refunds.push({ refundCents, lines: Object.keys(want).map((sku) => ({ sku, qty: want[sku] })), at: new Date(ctx.now).toISOString() });
+  order.status = allBack ? 'refunded' : 'partially_refunded';
+  for (const sku of Object.keys(want)) ctx.inventory.release(sku, want[sku]);
+  return { refundCents };
+}
+
+module.exports = { refundItems };
